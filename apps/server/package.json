{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"worker": "bun run src/worker.ts",
		"test": "bun --env-file=.env test src",
		"start": "bun run dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
	},
	"dependencies": {
		"@hono/trpc-server": "^0.4.2",
		"@hono/zod-validator": "^0.9.1",
		"@pasinpay/api": "workspace:*",
		"@pasinpay/chain": "workspace:*",
		"@pasinpay/auth": "workspace:*",
		"@pasinpay/db": "workspace:*",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"evlog": "catalog:",
		"hono": "^4.13.12",
		"jose": "^6.1.0",
		"viem": "^2.57.2",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@pasinpay/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	}
}
